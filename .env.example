# Environment under test (RHD-57736). dev2 is the default.
# Other environments: run with TEST_ENV=dev3 or TEST_ENV=uat (npm run test:uat, npm run ui:uat). Their accounts and
# test data go in .env.dev3 / .env.uat (copy .env.uat.example); anything missing there falls back to this file.
# BASE_URL is only needed to override the standard URL of the chosen environment.
BASE_URL=https://clinical.dev2.rethinkbhtech.com
BUILD_ID=

# Role accounts. When a role-specific login is blank the default account is used
# and the BCBA/RBT view is switched from the user menu (allowed by RHD-57736, note it in the report).
DEFAULT_USERNAME=
DEFAULT_PASSWORD=
BCBA_USERNAME=
BCBA_PASSWORD=
RBT_USERNAME=
RBT_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Test clients (see test-cases/00-test-data.md)
# dev2: Kora Noelle / Benson Moon / Cavin Mill
CLEAN_CLIENT_ID=260967
SEEDED_CLIENT_ID=472748
GROUP_CLIENT_ID=260960

# Seeded programs / behaviours on SEEDED_CLIENT_ID
SEEDED_OB_PROGRAM=Requesting preferred items
SEEDED_OB_TARGET=Snack items
SEEDED_TA_PROGRAM=Washing Hands (Task Analysis)
# Blank = not seeded in this environment; dependent specs create their own programs or skip.
SEEDED_INTERVAL_PROGRAM=
SEEDED_PEAK_PROGRAM=
SEEDED_FREQUENCY_PROGRAM=
SEEDED_BEHAVIOR=Self Injury
